{
  "name": "zenly",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend",
    "backend",
    "packages/shared"
  ],
  "scripts": {
    "build:shared": "npm run build --workspace packages/shared",
    "prebuild": "npm run build:shared",
    "predev": "npm run build:shared",
    "dev": "npm run dev --workspace frontend",
    "build": "npm run build --workspace frontend",
    "start": "npm run start --workspace frontend",
    "bdev": "cd backend && nodemon server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate-code": "echo 'Generating code (placeholder)...'",
    "generate-docs": "typedoc --out docs/api packages/shared/src/index.ts || echo 'Skipping docs for now'",
    "test:run": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.4.1",
    "globals": "^17.6.0",
    "next": "^16.2.9",
    "prettier": "^3.8.4",
    "type-coverage": "^2.29.7",
    "typedoc": "^0.28.19",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^9.0.1",

    "nodemon": "^3.1.10",
    "otp-generator": "^4.0.1"
  },
  "overrides": {
    "postcss": "^8.5.15"
  }
}

